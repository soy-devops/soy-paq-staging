  {
   "default": "<div class=\"inbound-scanner-container\" style=\"max-width: 850px; margin: 0 auto; padding: 25px; background: #ffffff; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);\">\n    \n    <div class=\"row mb-4\">\n        <div class=\"col-sm-12\">\n            <label style=\"font-size: 16px; font-weight: 700; color: #1f2937; margin-bottom: 8px; display: block;\">1. Scan Inbound ASN Barcode</label>\n            <input type=\"text\" id=\"scan-asn\" class=\"form-control form-control-lg\" placeholder=\"Scan or type ASN Reference (e.g., ASN-2026-00001)...\" style=\"font-size: 20px; font-weight: bold; height: 55px; border: 2px solid #d1d5db;\">\n        </div>\n    </div>\n\n    <div class=\"row mb-4\">\n        <div class=\"col-sm-12\">\n            <label style=\"font-size: 16px; font-weight: 700; color: #1f2937; margin-bottom: 8px; display: block;\">2. Scan Box License Plate Number (LPN) / Tracking</label>\n            <input type=\"text\" id=\"scan-box\" class=\"form-control form-control-lg\" placeholder=\"Scan physical box barcode...\" style=\"font-size: 20px; height: 55px;\" disabled>\n        </div>\n    </div>\n\n    <div class=\"row mb-4\">\n        <div class=\"col-sm-7\">\n            <label style=\"font-size: 16px; font-weight: 700; color: #1f2937; margin-bottom: 8px; display: block;\">3. Scan Item Barcode (SKU)</label>\n            <input type=\"text\" id=\"scan-item\" class=\"form-control form-control-lg\" placeholder=\"Scan item barcode...\" style=\"font-size: 20px; height: 55px;\" disabled>\n        </div>\n        <div class=\"col-sm-5\">\n            <label style=\"font-size: 16px; font-weight: 700; color: #1f2937; margin-bottom: 8px; display: block;\">Target Putaway Storage Bin</label>\n            <input type=\"text\" id=\"scan-bin\" class=\"form-control form-control-lg\" placeholder=\"Scan shelf/bin location...\" style=\"font-size: 20px; height: 55px;\" disabled>\n        </div>\n    </div>\n\n    <hr style=\"border-top: 2px dashed #e5e7eb; margin: 30px 0;\">\n\n    <h4 class=\"mb-3\" style=\"font-weight: 700; color: #374151;\">Current Box Processing Queue</h4>\n    <div class=\"table-responsive\">\n        <table class=\"table table-hover table-bordered\" id=\"scanned-items-table\" style=\"border-radius: 6px; overflow: hidden;\">\n            <thead style=\"background-color: #f9fafb;\">\n                <tr>\n                    <th style=\"font-weight:600; color:#4b5563;\">Scanned Item Code / SKU</th>\n                    <th style=\"font-weight:600; color:#4b5563; width: 160px;\">Actual Received Qty</th>\n                    <th style=\"font-weight:600; color:#4b5563;\">Assigned Bin Location</th>\n                </tr>\n            </thead>\n            <tbody id=\"scanned-items-body\">\n                <tr><td colspan=\"3\" class=\"text-muted text-center\" style=\"padding: 20px;\">Awaiting active ASN and Box scans to start receiving...</td></tr>\n            </tbody>\n        </table>\n    </div>\n\n    <div class=\"text-right mt-4\" style=\"display: flex; justify-content: flex-end; gap: 12px;\">\n        <button id=\"btn-save-box\" class=\"btn btn-primary btn-lg\" style=\"font-weight:700; padding: 12px 30px; font-size: 18px;\" disabled>Save Box & Clear</button>\n        <button id=\"btn-post-ledger\" class=\"btn btn-success btn-lg\" style=\"font-weight:700; padding: 12px 30px; font-size: 18px;\" disabled>Complete ASN & Transfer to Ledger</button>\n    </div>\n</div>",
